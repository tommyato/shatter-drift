{
  "name": "shatter-drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sd/client",
    "build": "npm run build -w @sd/sim && npm run build -w @sd/client",
    "build:sim": "npm run build -w @sd/sim",
    "build:client": "npm run build -w @sd/client",
    "preview": "npm run preview -w @sd/client",
    "test:harness": "npm run test:harness -w @sd/client",
    "determinism": "npm run test:harness -w @sd/client",
    "validate-sim": "npm run validate -w @sd/sim",
    "mp-smoke": "npm run mp-smoke -w @sd/client",
    "typecheck": "npm run typecheck -w @sd/sim && npm run typecheck -w @sd/client"
  }
}
