{
  "name": "@sd/sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./systems/*": "./src/systems/*.ts",
    "./input/*": "./src/input/*.ts",
    "./lib/di": "./src/lib/di/index.ts",
    "./lib/token": "./src/lib/token/index.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "validate": "npm run build && node validate-sim.mjs",
    "verify-patterns": "npm run build && node verify-patterns.mjs",
    "verify-spatial-hash": "npm run build && node verify-spatial-hash.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
